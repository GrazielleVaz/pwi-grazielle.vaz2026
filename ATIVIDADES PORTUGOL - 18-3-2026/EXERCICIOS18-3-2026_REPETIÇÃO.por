programa
{
	
	funcao inicio()
	{
	inteiro numero = 0
	cadeia nome
	inteiro repetir
	
	escreva("Digite seu nome:\n ")
	leia(nome)

	escreva("Digite a Quantidade de repetições: \n")
	leia(repetir)

	enquanto (numero<=repetir)
			
	{
		escreva(nome)
		escreva("\n")
		numero = numero+1
	}

	escreva("\n \nFim de execucao\n")
	
	}
}
